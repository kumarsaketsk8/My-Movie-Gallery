# Copy to .env.local and replace with the values from Supabase Dashboard → Connect.
# This is a browser-safe publishable key, never a secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Create a TMDB API Read Access Token in TMDB → Settings → API, then add it here.
# Vite variables are exposed to the browser, so use this only for the personal,
# local-first app. Add a server-side proxy before using a token that must stay private.
VITE_TMDB_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token
# Alternatively, use a v3 API key:
# VITE_TMDB_API_KEY=replace_with_your_tmdb_v3_api_key
